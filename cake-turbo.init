#!/bin/sh /etc/rc.common
# procd service for cake-turbo. The script itself waits for SQM's cake qdiscs.

START=97
STOP=4
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/bash /root/cake-turbo/cake-turbo.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
